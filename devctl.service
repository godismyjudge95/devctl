# NOTE: This is a template for development use with `make install`.
# For production, use `sudo devctl install` which generates this file
# automatically from your system's user configuration.
#
# The daemon runs as the site user (not root). AmbientCapabilities lets
# supervised Caddy bind :80/:443 without setcap on the Caddy binary.
[Unit]
Description=devctl — Local PHP Dev Dashboard
After=network.target

[Service]
Type=simple
User=<username>
Group=<username>
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/home/<username>/ddev/sites/server/devctl/devctl daemon
Restart=on-failure
RestartSec=5s
Environment=HOME=/home/<username>
Environment=DEVCTL_SITE_USER=<username>
Environment=DEVCTL_SERVER_ROOT=/home/<username>/ddev/sites/server

[Install]
WantedBy=multi-user.target
